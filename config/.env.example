# DeepSeek API（每日AI预测用，2026-07-20 用户提供）
# 盘后定时任务调用生成 daily_brief.json，每天1次省成本
# 代码用 os.environ.get() 读，不写死；周末实施时 agent 只读变量名不看 key 值
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# R2 迁移阶段2：Worker /api/purge-cache endpoint 认证密钥（2026-08-08）
# upload_r2.py 上传后调 purge_cache() POST /api/purge-cache 清 CF 边缘缓存
# Worker 侧用 wrangler secret put PURGE_SECRET 设同名值（不进 git，CF secret 存储）
PURGE_SECRET=<your-purge-secret>
