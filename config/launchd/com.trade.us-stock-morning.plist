<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trade.us-stock-morning</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/USER/code/trade-data/scripts/us_stock_morning.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>REPO</key>
        <string>/Users/USER/code/trade-data</string>
        <key>GIT_REPO</key>
        <string>/Users/USER/code/trade</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/USER/code/trade-data</string>
    <key>StandardOutPath</key>
    <string>/Users/USER/code/trade-data/data/logs/us_stock_morning_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USER/code/trade-data/data/logs/us_stock_morning_launchd.err</string>
    <key>RunAtLoad</key>
    <false/>
    <!-- 05:00 触发：美股 04:00 收盘（DST 夏令时 16:00 EDT=04:00 CST）后 1 小时余量防源延迟。
         采集~5s + deploy 全量 export+push ~3-5min，给 1800s(30min) 余量。 -->
    <key>ExitTimeOut</key>
    <integer>1800</integer>
</dict>
</plist>
