# staticdata 备份仓库 .gitignore
# 灾备4层: trade git(代码) / staticdata(差异日志) / R2私有桶(DB gz) / R2公开桶(大文件分发)
#
# 排除大文件(只走R2公开桶):
index-*
industry-*
lab-*
trade_sim_*[0-9]*

# 排除压缩文件(git 无法 diff 二进制 gz):
*.gz

# 排除非数据文件:
feed.xml

# DB 文件: 4个DB均>100MB(sentiment 122MB/etf_nt 172MB/public_fund 2.1GB/stock_daily 51MB),
# 超 GitHub 100MB 文件限制,需 git-lfs 才能推送。
# 当前 git-lfs 未安装,DB 不进 git(由 R2 私有桶 gz 快照备份,灾备第3层)。
# DB 仍 rsync 到 staticdata/db/ 作本地备份(deploy.sh 每次 deploy 后刷新)。
# 安装 git-lfs 后:删除下行 + 在 .gitattributes 加 "db/*.db filter=lfs diff=lfs merge=lfs -text"
db/*.db

# 保留:
# config/*     (配置: .env.example/wrangler.jsonc/launchd plist模板)
# data/*.json  (小JSON差异化日志)

# >>> large-json auto-generated >>>
# 由 scripts/large_json_excludes.py 自动维护(2026-09-25), 勿手改。
# 排除 staticdata 备份 git 仓库 data/ 下 >20MB 的 JSON: 移出 git, 改走 R2 私有桶
# signal-backup large-json/<YYYY-MM-DD>/<相对data路径>.gz 每日备份(日14天+周8周+月12月)。
/data/accum_nav_map.json
/data/offshore_fund_fee_detail.json
/data/offshore_fund_performance.json
/data/offshore_fund_purchase_status.json
/data/offshore_fund_risk_indicator.json
/data/signal_kelly_trades.json
/data/signal_kelly_trades_sdc.json
/data/trade_sim/trade_sim_cgb_idx_full.json
# <<< large-json auto-generated <<<

